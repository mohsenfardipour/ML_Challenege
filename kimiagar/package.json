{
  "name": "kimiagar",
  "version": "1.0.0",
  "private": true,
  "description": "Kimiagar - offline 45-day workbook",
  "author": "Kimiagar",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "dexie": "4.0.10",
    "dexie-react-hooks": "1.1.7",
    "jalaali-js": "1.2.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vazirmatn": "33.0.3"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "33.2.1",
    "electron-builder": "25.1.8",
    "fake-indexeddb": "6.0.0",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  },
  "build": {
    "appId": "local.kimiagar.app",
    "productName": "Kimiagar",
    "files": ["dist/**/*", "electron/**/*"],
    "directories": { "output": "release" },
    "win": { "target": "nsis", "signAndEditExecutable": false },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "shortcutName": "کیمیاگر" }
  }
}
